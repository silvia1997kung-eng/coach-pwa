<!DOCTYPE html>
<html lang="zh-TW">
<head>
<script>
const APP_VERSION = '1.0.0';
function checkForUpdate(manual){
  var btn=document.getElementById('update-icon');
  if(btn) btn.style.animation='spin 1s linear infinite';
  fetch(window.location.href+'?v='+Date.now(),{cache:'no-store',headers:{'Cache-Control':'no-cache'}})
  .then(function(r){return r.text()})
  .then(function(html){
    if(btn) btn.style.animation='';
    var m=html.match(/APP_VERSION = '([^']+)'/);
    if(m&&m[1]&&m[1]!==APP_VERSION){
      showUpdateBanner(m[1]);
    } else if(manual){
      toast('已是最新版本 v'+APP_VERSION+' ✓');
    }
  }).catch(function(){
    if(btn) btn.style.animation='';
    if(manual) toast('無法連線，請確認網路');
  });
}
function manualUpdate(){
  toast('正在檢查更新…');
  checkForUpdate(true);
}
function showUpdateBanner(v){
  if(document.getElementById('upd-banner'))return;
  var b=document.createElement('div');
  b.id='upd-banner';
  b.style.cssText='position:fixed;top:0;left:0;right:0;z-index:9999;background:#4A6347;color:#fff;padding:calc(12px + env(safe-area-inset-top,0px)) 16px 12px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;box-shadow:0 2px 12px rgba(0,0,0,.3)';
  b.innerHTML='<div style="display:flex;align-items:center;gap:9px"><span style="font-size:20px">🔄</span><div><div style="font-weight:600">新版本 v'+v+' 可用</div><div style="opacity:.75;font-size:11px;margin-top:1px">點擊更新以使用最新功能</div></div></div>'
    +'<button onclick="doUpdate()" style="background:#F5EAC2;color:#2C3A2A;border:none;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap;flex-shrink:0">立即更新</button>';
  document.body.insertBefore(b,document.body.firstChild);
  var badge=document.getElementById('update-badge');
  if(badge) badge.style.display='block';
}
function doUpdate(){
  if('caches' in window){
    caches.keys().then(function(names){
      return Promise.all(names.map(function(n){return caches.delete(n)}));
    }).then(function(){window.location.reload(true)});
  } else {
    window.location.reload(true);
  }
}
window.addEventListener('load',function(){setTimeout(function(){checkForUpdate(false)},3000)});
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Coach Studio">
<meta name="theme-color" content="#6F8D6B">
<title>Coach Studio</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --purple:#6F8D6B;--purple-l:#E8F2E7;--purple-m:#A8C6A1;--purple-d:#4A6347;
  --teal:#A4BCC2;--teal-l:#E4EEF0;
  --bg:#FAF8F2;--surface:#FFFFFF;--surface2:#F0EDE3;
  --text:#2C3A2A;--text2:#5A6B57;--text3:#8FA68C;
  --border:#D8E4D6;--border2:#C5D8C2;
  --red:#8B3A2A;--red-l:#F5E8E5;
  --green:#6F8D6B;--green-l:#E8F2E7;
  --radius:12px;--radius-sm:8px;--radius-xs:6px;
  --safe-top:env(safe-area-inset-top,0px);
  --safe-bottom:env(safe-area-inset-bottom,0px);
}
html,body{height:100%;overflow:hidden;background:var(--bg);font-family:-apple-system,BlinkMacSystemFont,'Helvetica Neue',sans-serif;font-size:15px;color:var(--text)}
#app{display:flex;flex-direction:column;height:100%;padding-top:var(--safe-top)}

/* Top header */
.header{background:var(--purple);color:#fff;padding:14px 16px 12px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.header-title{font-size:17px;font-weight:600;letter-spacing:-.3px}
.header-sub{font-size:12px;opacity:.75;margin-top:1px}
.header-btn{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.18);border:none;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px}

/* Scrollable content area */
.content{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;background:var(--bg);padding:14px 14px calc(80px + var(--safe-bottom))}

/* Bottom nav */
.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#FAF8F2;border-top:1px solid var(--border);display:flex;padding-bottom:var(--safe-bottom);z-index:100}
.nav-tab{flex:1;padding:10px 4px 8px;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;color:var(--text3);border:none;background:none;font-family:inherit}
.nav-tab.active{color:var(--purple-d)}
.nav-tab i{font-size:22px}
.nav-tab span{font-size:10px;font-weight:500}

/* Cards */
.card{background:var(--surface);border-radius:var(--radius);padding:14px;margin-bottom:10px;border:1px solid var(--border)}
.card-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.card-title{font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;color:var(--text)}
.section-label{font-size:11px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;margin:14px 0 8px;display:flex;align-items:center;gap:7px}
.section-label::after{content:'';flex:1;height:1px;background:#A8C6A1}

/* Buttons */
.btn{padding:9px 16px;border-radius:var(--radius-sm);border:1px solid var(--border2);background:var(--surface);cursor:pointer;font-size:13px;color:var(--text);display:inline-flex;align-items:center;gap:6px;font-family:inherit;font-weight:500;transition:opacity .1s;-webkit-appearance:none}
.btn:active{opacity:.7}
.btn-primary{background:var(--purple);color:#fff;border-color:var(--purple)}
.btn-sm{padding:6px 12px;font-size:12px}
.btn-teal{background:var(--teal-l);color:var(--teal);border-color:var(--teal-l)}
.btn-danger{background:var(--red-l);color:var(--red);border-color:var(--red-l)}
.btn-block{width:100%;justify-content:center}
.btn-ghost{border-color:transparent;background:transparent;padding-left:4px;padding-right:4px}

/* Forms */
.field{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.field label{font-size:12px;font-weight:600;color:var(--text2)}
.field input,.field select,.field textarea{border:1px solid var(--border2);border-radius:var(--radius-sm);padding:10px 12px;font-size:15px;background:var(--surface);color:var(--text);width:100%;font-family:inherit;-webkit-appearance:none;appearance:none}
.field textarea{resize:vertical;min-height:80px}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px var(--purple-l)}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.f3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}

/* Badges */
.badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600}
.badge-purple{background:var(--purple-l);color:var(--purple)}
.badge-teal{background:#E4EEF0;color:#4A7580}
.badge-gray{background:var(--surface2);color:var(--text2)}

/* Student list */
.stu-item{display:flex;align-items:center;gap:12px;padding:13px 14px;background:var(--surface);border-radius:var(--radius);margin-bottom:8px;border:1px solid var(--border);cursor:pointer}
.stu-item:active{opacity:.7}
.stu-avatar{width:42px;height:42px;border-radius:50%;background:#A8C6A1;color:#4A6347;font-size:17px;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.stu-info{flex:1;min-width:0}
.stu-name{font-size:15px;font-weight:600}
.stu-sub{font-size:12px;color:var(--text2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* Info rows */
.info-row{display:flex;justify-content:space-between;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--border)}
.info-row:last-child{border-bottom:none}
.info-lbl{font-size:12px;color:var(--text2);font-weight:500;min-width:90px}
.info-val{font-size:13px;color:var(--text);font-weight:500;text-align:right;flex:1}

/* Exercise blocks */
.ex-block{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:10px;overflow:hidden}
.ex-hd{background:#F5EAC2;padding:11px 13px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border)}
.ex-hd-title{font-size:13px;font-weight:600;display:flex;align-items:center;gap:7px}
.ex-body{padding:13px}

/* Set table */
.set-table{width:100%;border-collapse:collapse;font-size:13px}
.set-table th{padding:7px 6px;background:#F5EAC2;color:var(--text2);font-weight:600;font-size:11px;text-align:left;border-bottom:1px solid var(--border)}
.set-table th:first-child{width:30px;text-align:center;border-radius:var(--radius-xs) 0 0 0}
.set-table td{padding:5px 4px;border-bottom:1px solid var(--border);vertical-align:middle}
.set-table td:first-child{text-align:center;font-size:11px;color:var(--text3);font-weight:600}
.set-table tr:last-child td{border-bottom:none}
.set-input{border:1px solid var(--border2);border-radius:var(--radius-xs);padding:6px 7px;font-size:13px;background:var(--surface);color:var(--text);width:100%;font-family:inherit;-webkit-appearance:none}
.set-input:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 2px var(--purple-l)}

/* Add buttons */
.add-row-btn{border:1px dashed var(--border2);border-radius:var(--radius-sm);padding:8px;font-size:12px;color:var(--text3);background:transparent;width:100%;display:flex;align-items:center;justify-content:center;gap:5px;margin-top:8px;cursor:pointer;font-family:inherit}
.add-row-btn:active{background:var(--purple-l);color:var(--purple);border-color:var(--purple)}
.add-ex-btn{border:2px dashed var(--border2);border-radius:var(--radius);padding:16px;font-size:14px;color:var(--text3);background:transparent;width:100%;display:flex;align-items:center;justify-content:center;gap:7px;margin-top:6px;cursor:pointer;font-family:inherit}
.add-ex-btn:active{background:var(--purple-l);color:var(--purple);border-color:var(--purple)}

/* Spring dots */
.spring-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin:6px 0}
.sdot{width:28px;height:28px;border-radius:50%;cursor:pointer;border:3px solid transparent;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0}
.sdot.sel{border-color:var(--text);transform:scale(1.1)}
.spring-qty-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}
.spring-qty-chip{display:flex;align-items:center;gap:6px;font-size:12px;background:var(--surface2);padding:5px 10px;border-radius:20px;border:1px solid var(--border)}

/* Photos */
.photo-upload-zone{border:2px dashed var(--border2);border-radius:var(--radius);padding:28px 16px;text-align:center;cursor:pointer;color:var(--text3);margin-bottom:12px}
.photo-upload-zone i{font-size:32px;display:block;margin-bottom:8px}
.photo-upload-zone p{font-size:14px;margin-bottom:4px}
.photo-upload-zone small{font-size:12px}
.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.photo-thumb{position:relative;border-radius:var(--radius-sm);overflow:hidden;aspect-ratio:1;border:1px solid var(--border)}
.photo-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.photo-del{position:absolute;top:4px;right:4px;width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,.55);border:none;color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.photo-caption{width:100%;margin-top:4px;border:1px solid var(--border2);border-radius:var(--radius-xs);padding:5px 8px;font-size:12px;background:var(--surface);color:var(--text);font-family:inherit}

/* Lightbox */
.lightbox{background:rgba(0,0,0,.88);border-radius:var(--radius);padding:16px;margin-bottom:12px;text-align:center}
.lightbox img{max-width:100%;max-height:55vh;border-radius:var(--radius-sm);object-fit:contain}
.lightbox-caption{color:rgba(255,255,255,.8);font-size:13px;margin-top:8px}
.lightbox-nav{display:flex;justify-content:center;gap:10px;margin-top:12px}

/* Log history card */
.log-card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);margin-bottom:10px;overflow:hidden}
.log-card-hd{background:#F5EAC2;padding:11px 13px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:8px}
.log-card-body{padding:12px 13px}

/* Alert toast */
.toast{position:fixed;top:calc(var(--safe-top) + 60px);left:50%;transform:translateX(-50%);background:var(--text);color:#fff;padding:10px 18px;border-radius:30px;font-size:13px;font-weight:500;z-index:999;opacity:0;transition:opacity .2s;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1}
.toast.success{background:#4A6347}
.toast.error{background:#A32D2D}

/* Page transitions */
.page{display:none}
.page.active{display:block}
.hidden{display:none!important}

/* Back nav */
.back-hd{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.back-hd h2{font-size:17px;font-weight:600;flex:1}

/* Tab bar within page */
.seg{display:flex;background:#E8F0E7;border-radius:var(--radius-sm);padding:3px;gap:2px;margin-bottom:14px}
.seg-btn{flex:1;padding:8px 6px;border-radius:var(--radius-xs);border:none;background:transparent;font-size:12px;font-weight:500;color:var(--text2);cursor:pointer;font-family:inherit;text-align:center}
.seg-btn.active{background:#F5EAC2;color:var(--purple-d);font-weight:600;box-shadow:0 1px 3px rgba(0,0,0,.1)}

/* DB section */
.db-block-label{font-size:11px;font-weight:700;color:var(--purple);text-transform:uppercase;letter-spacing:.06em;padding:6px 0 4px;border-top:1px solid var(--border);margin-top:10px}
.db-block-label:first-child{border-top:none;margin-top:0}
.db-ex-row{display:flex;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);gap:10px}
.db-ex-row:last-child{border-bottom:none}
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
</style>
