function deleteStu(id){
  var s=state.students.find(function(x){return x.id===id});
  if(!s)return;
  var logs=state.logs.filter(function(l){return l.studentId===id}).length;
  var msg='確定要刪除學員「'+s.name+'」嗎？';
  if(logs>0) msg+='\n（同時刪除 '+logs+' 筆課程紀錄）';
  msg+='\n此操作無法復原。';
  if(!confirm(msg))return;
  state.students=state.students.filter(function(x){return x.id!==id});
  state.logs=state.logs.filter(function(l){return l.studentId!==id});
  save();
  toast('學員已刪除');
  showStuList();
}

