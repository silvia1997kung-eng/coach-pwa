  return`<tr><td>${n}</td>
    <td><input class="set-input" placeholder="40kg" value="${s.weight||''}" style="min-width:60px"></td>
    <td><input class="set-input" placeholder="12" value="${s.reps||''}" style="min-width:40px"></td>
    <td><input class="set-input" placeholder="90秒" value="${s.rest||''}" style="min-width:55px"></td>
    <td><input class="set-input" placeholder="備註" value="${s.note||''}" style="min-width:70px"></td>
    <td><button class="btn btn-ghost" style="padding:4px;color:var(--red)" onclick="this.closest('tr').remove()"><i class="ti ti-x" style="font-size:14px"></i></button></td>
  </tr>`;
}
function addSetRow(exId){
  const tb=document.getElementById(exId+'-tbody');
  tb.insertAdjacentHTML('beforeend',setRow(exId,tb.querySelectorAll('tr').length+1,{}));
}

function getPilatesNames(block){return state.exercises.pilates.filter(e=>e.block===block).map(e=>e.name)}

function addPilatesEx(pre){
  pCount++;const id='pex-'+pCount;
  const initBlock=pre?.block||BASI[0];
  const selSprings=pre?.springs||[];
  const div=document.createElement('div');div.className='ex-block';div.id=id;
  div.innerHTML=`<div class="ex-hd">
    <div class="ex-hd-title"><i class="ti ti-stretching" style="color:var(--teal)"></i> 皮拉提斯動作 #${pCount}</div>
    <button class="btn btn-danger btn-sm" onclick="document.getElementById('${id}').remove()"><i class="ti ti-trash"></i></button>
  </div>
  <div class="ex-body">
    <div class="f2">
      <div class="field"><label>BASI 板塊</label>
        <select id="${id}-block" onchange="updatePNames('${id}')">${BASI.map(b=>`<option${initBlock===b?' selected':''}>${b}</option>`).join('')}</select>
      </div>
      <div class="field"><label>動作名稱</label><select id="${id}-name"></select></div>
    </div>
    <div class="f2">
      <div class="field"><label>難易程度</label>
        <select id="${id}-level">${['基礎','中級','進階'].map(l=>`<option${pre?.level===l?' selected':''}>${l}</option>`).join('')}</select>
      </div>
      <div class="field"><label>目標肌群</label><input id="${id}-muscle" value="${pre?.muscle||''}" placeholder="腹部核心"></div>
    </div>
    <div class="field"><label>建議彈簧重</label>
      <div class="spring-row" id="${id}-sdots">
        ${SPRINGS.map(c=>`<div class="sdot${selSprings.some(s=>s.color===c.key)?' sel':''}" style="background:${c.hex}" onclick="toggleSpring('${id}',this,'${c.key}')">${c.key[0]}</div>`).join('')}
        <span style="font-size:12px;color:var(--text3)">點選顏色</span>
      </div>
      <div class="spring-qty-row" id="${id}-sqty"></div>
      <div style="display:flex;align-items:center;gap:8px;margin-top:8px">
        <span style="font-size:12px;color:var(--text3)">其他：</span>
        <input id="${id}-cspring" value="${pre?.customSpring||''}" placeholder="長彈簧×1" style="flex:1;border:1px solid var(--border2);border-radius:var(--radius-xs);padding:7px 10px;font-size:13px;background:var(--surface);color:var(--text);font-family:inherit">
      </div>
    </div>
    <div class="f2">
      <div class="field"><label>已學習次數</label><input type="number" id="${id}-times" value="${pre?.timesLearned||'1'}" min="0"></div>
      <div class="field"><label>注意情況</label><input id="${id}-note" value="${pre?.note||''}" placeholder="今日觀察…"></div>
    </div>
  </div>`;
  document.getElementById('pilates-exercises').appendChild(div);
  updatePNames(id,pre?.name);
  if(selSprings.length)selSprings.forEach(s=>renderSpringQty(id,s.color,true,s.qty));
}

function updatePNames(id,pre){
  const bl=document.getElementById(id+'-block');const nm=document.getElementById(id+'-name');
  if(!bl||!nm)return;
  const names=getPilatesNames(bl.value);
  nm.innerHTML=names.length?names.map(n=>`<option${pre===n?' selected':''}>${n}</option>`).join(''):`<option value=''>— 此板塊尚無動作 —</option>`;
}

function toggleSpring(id,el,color){
  el.classList.toggle('sel');
  renderSpringQty(id,color,el.classList.contains('sel'),'');
}
function renderSpringQty(id,color,add,def){
  const row=document.getElementById(id+'-sqty');if(!row)return;
  const ex=row.querySelector(`[data-color="${color}"]`);
  const ci=SPRINGS.find(c=>c.key===color);
  if(add&&!ex){
    const w=document.createElement('div');w.className='spring-qty-chip';w.dataset.color=color;
    w.innerHTML=`<span style="width:12px;height:12px;border-radius:50%;background:${ci?.hex||'#888'};display:inline-block"></span>
      <span style="color:var(--text2)">${color}(${ci?.val})</span>
      <input type="number" min="1" max="10" value="${def||1}" data-qty style="width:40px;border:1px solid var(--border2);border-radius:var(--radius-xs);padding:4px 6px;font-size:12px;background:var(--surface);color:var(--text);font-family:inherit"> 條`;
    row.appendChild(w);
  }else if(!add&&ex){row.removeChild(ex)}
}
function collectSprings(id){
  const row=document.getElementById(id+'-sqty');if(!row)return[];
  return Array.from(row.querySelectorAll('[data-color]')).map(w=>({color:w.dataset.color,qty:w.querySelector('[data-qty]')?.value||'1'}));
}

function handlePhotoUpload(e){
  Array.from(e.target.files).forEach(f=>{
    const r=new FileReader();
    r.onload=ev=>{logPhotos.push({dataUrl:ev.target.result,caption:''});renderLogPhotos()};
    r.readAsDataURL(f);
  });
  e.target.value='';
}
function renderLogPhotos(){
  const grid=document.getElementById('log-photo-grid');
  grid.innerHTML=logPhotos.map((p,i)=>`
    <div>
      <div class="photo-thumb" onclick="previewPhoto(${i},'log')">
        <img src="${p.dataUrl}" alt="">
        <button class="photo-del" onclick="event.stopPropagation();logPhotos.splice(${i},1);renderLogPhotos()"><i class="ti ti-x" style="font-size:11px"></i></button>
      </div>
      <input class="photo-caption" placeholder="說明" value="${p.caption||''}" oninput="logPhotos[${i}].caption=this.value">
    </div>`).join('');
}

let previewCtx={photos:[],idx:0,logId:null};
function previewPhoto(idx,src,logId){
  const photos=src==='log'?logPhotos:(state.logs.find(l=>l.id===logId)?.photos||[]);
  previewCtx={photos,idx,logId};
  showPreview();
}
function showPreview(){
  const {photos,idx}=previewCtx;
  const p=photos[idx];if(!p)return;
  const el=document.getElementById('photo-preview-overlay');
  if(el)el.remove();
  const ov=document.createElement('div');
  ov.id='photo-preview-overlay';
  ov.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:500;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;';
  ov.innerHTML=`<img src="${p.dataUrl}" style="max-width:100%;max-height:70vh;border-radius:12px;object-fit:contain">
    ${p.caption?`<div style="color:rgba(255,255,255,.8);font-size:13px;margin-top:10px">${p.caption}</div>`:''}
    <div style="display:flex;gap:12px;margin-top:16px">
      ${idx>0?`<button class="btn" style="background:rgba(255,255,255,.15);color:#fff;border-color:rgba(255,255,255,.3)" onclick="previewCtx.idx--;showPreview()"><i class="ti ti-chevron-left"></i></button>`:''}
      <button class="btn" style="background:rgba(255,255,255,.15);color:#fff;border-color:rgba(255,255,255,.3)" onclick="document.getElementById('photo-preview-overlay').remove()"><i class="ti ti-x"></i> 關閉</button>
      ${idx<photos.length-1?`<button class="btn" style="background:rgba(255,255,255,.15);color:#fff;border-color:rgba(255,255,255,.3)" onclick="previewCtx.idx++;showPreview()"><i class="ti ti-chevron-right"></i></button>`:''}
    </div>`;
  document.body.appendChild(ov);
}

function saveLog(){
  const date=document.getElementById('log-date').value;
  const studentId=parseInt(document.getElementById('log-student').value);
  if(!date||!studentId){toast('請填寫日期和學員','error');return}
  const wBlocks=document.querySelectorAll('[id^="wex-"]');
  const pBlocks=document.querySelectorAll('[id^="pex-"]');
  const weightEx=Array.from(wBlocks).map(b=>{
    const rows=b.querySelectorAll('tbody tr');
    return{name:document.getElementById(b.id+'-name')?.value||'',
      sets:Array.from(rows).map(r=>{const ins=r.querySelectorAll('input');return{weight:ins[0]?.value||'',reps:ins[1]?.value||'',rest:ins[2]?.value||'',note:ins[3]?.value||''}})};
  });
  const pilatesEx=Array.from(pBlocks).map(b=>({
    name:document.getElementById(b.id+'-name')?.value||'',
    block:document.getElementById(b.id+'-block')?.value||'',
    level:document.getElementById(b.id+'-level')?.value||'',
    muscle:document.getElementById(b.id+'-muscle')?.value||'',
    springs:collectSprings(b.id),
    customSpring:document.getElementById(b.id+'-cspring')?.value||'',
    timesLearned:document.getElementById(b.id+'-times')?.value||'',
    note:document.getElementById(b.id+'-note')?.value||''
  }));
  state.logs.unshift({
    id:state.nextId++,studentId,
    date:date.replace(/-/g,'/'),
    time:document.getElementById('log-time').value,
    location:document.getElementById('log-location').value,
    weightEx,pilatesEx,
    photos:logPhotos.map(p=>({dataUrl:p.dataUrl,caption:p.caption||''})),
    note:document.getElementById('log-note').value
  });
  save();toast('課程紀錄已儲存！');clearLog();
}

function clearLog(){
  document.getElementById('weight-exercises').innerHTML='';
  document.getElementById('pilates-exercises').innerHTML='';
  document.getElementById('log-note').value='';
  document.getElementById('log-location').value='';
  document.getElementById('log-photo-grid').innerHTML='';
  logPhotos=[];wCount=0;pCount=0;
  switchSeg('weight');
}

/* ===== DB ===== */
function renderDb(){renderDbW();renderDbP()}
function renderDbW(){
  document.getElementById('db-weight-list').innerHTML=state.exercises.weight.map((e,i)=>`
    <div class="db-ex-row">
      <i class="ti ti-barbell" style="color:var(--purple);font-size:18px;flex-shrink:0"></i>
      <div style="flex:1;min-width:0">
        <div style="font-weight:600;font-size:14px">${e.name}</div>
        <div style="font-size:12px;color:var(--text2)">${e.muscle}${e.note?' · '+e.note:''}</div>
      </div>
      <button class="btn btn-danger btn-sm" onclick="rmDb('weight',${i})"><i class="ti ti-trash"></i></button>
    </div>`).join('');
}
function renderDbP(){
  const byBlock={};BASI.forEach(b=>byBlock[b]=[]);
  state.exercises.pilates.forEach(e=>{if(byBlock[e.block])byBlock[e.block].push(e)});
  document.getElementById('db-pilates-list').innerHTML=BASI.map(b=>{
    const exs=byBlock[b];if(!exs.length)return'';
    return`<div class="db-block-label">${b}</div>
    ${exs.map(e=>{const i=state.exercises.pilates.indexOf(e);return`
      <div class="db-ex-row">
        <i class="ti ti-stretching" style="color:var(--teal);font-size:18px;flex-shrink:0"></i>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:14px">${e.name} <span class="badge badge-teal" style="font-size:10px">${e.level}</span></div>
          <div style="font-size:12px;color:var(--text2)">${e.muscle}${e.note?' · '+e.note:''}</div>
        </div>
        <button class="btn btn-danger btn-sm" onclick="rmDb('pilates',${i})"><i class="ti ti-trash"></i></button>
      </div>`}).join('')}`;
  }).join('');
}
function addDbEx(type){
  if(type==='weight'){
    const name=document.getElementById('db-w-name').value;if(!name){toast('請輸入動作名稱','error');return}
    state.exercises.weight.push({name,muscle:document.getElementById('db-w-muscle').value,note:document.getElementById('db-w-note').value});
    ['db-w-name','db-w-muscle','db-w-note'].forEach(id=>document.getElementById(id).value='');
    renderDbW();
  }else{
    const name=document.getElementById('db-p-name').value;if(!name){toast('請輸入動作名稱','error');return}
    state.exercises.pilates.push({name,block:document.getElementById('db-p-block').value,level:document.getElementById('db-p-level').value,muscle:document.getElementById('db-p-muscle').value,note:document.getElementById('db-p-note').value});
    ['db-p-name','db-p-muscle','db-p-note'].forEach(id=>document.getElementById(id).value='');
    renderDbP();
  }
  save();toast('動作已加入資料庫！');
}
function rmDb(type,idx){state.exercises[type].splice(idx,1);save();type==='weight'?renderDbW():renderDbP()}

/* ===== HISTORY ===== */
function renderHistFilter(){
  const sel=document.getElementById('hist-filter');const cur=sel.value;
  sel.innerHTML='<option value="">全部學員</option>'+state.students.map(s=>`<option value="${s.id}">${s.name}</option>`).join('');
  if(cur)sel.value=cur;
}
function renderHistory(){
  const fv=document.getElementById('hist-filter').value;
  const logs=fv?state.logs.filter(l=>l.studentId==fv):state.logs;
  const el=document.getElementById('history-list');
  if(!logs.length){el.innerHTML='<div style="text-align:center;padding:50px;color:var(--text3)"><i class="ti ti-calendar-off" style="font-size:48px;display:block;margin-bottom:10px"></i>尚無訓練紀錄</div>';return}
  const wd=['日','一','二','三','四','五','六'];
  const springStr=spr=>spr.map(s=>`${s.color}×${s.qty}`).join('+');
  el.innerHTML=logs.map(l=>{
    const s=state.students.find(x=>x.id===l.studentId);
    const d=new Date(l.date.replace(/\//g,'-'));
    const wdStr=isNaN(d)?'':` 週${wd[d.getDay()]}`;
    const photoCount=l.photos?.length||0;
    return`<div class="log-card" id="hlog-${l.id}">
      <div class="log-card-hd">
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:14px">${l.date}${wdStr} ${l.time}</div>
          <div style="display:flex;gap:5px;margin-top:4px;flex-wrap:wrap">
            <span class="badge badge-purple">${s?.name||'未知'}</span>
            ${l.location?`<span class="badge badge-gray">${l.location}</span>`:''}
            ${photoCount?`<span class="badge badge-teal"><i class="ti ti-camera" style="font-size:11px"></i> ${photoCount}</span>`:''}
          </div>
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn btn-teal btn-sm" onclick="editHistLog(${l.id})"><i class="ti ti-edit"></i></button>
          <button class="btn btn-danger btn-sm" onclick="deleteLog(${l.id})"><i class="ti ti-trash"></i></button>
        </div>
      </div>
      <div class="log-card-body">
        ${l.weightEx?.length?`<div class="section-label">重訓</div>
          ${l.weightEx.map(e=>`<div style="margin-bottom:10px">
            <div style="font-weight:600;font-size:13px;margin-bottom:6px;display:flex;align-items:center;gap:6px"><i class="ti ti-barbell" style="color:var(--purple)"></i>${e.name}</div>
            <div style="overflow-x:auto"><table class="set-table" style="min-width:280px">
              <thead><tr><th>組</th><th>重量</th><th>次數</th><th>休息</th><th>備註</th></tr></thead>
              <tbody>${(e.sets||[]).map((s,i)=>`<tr><td>${i+1}</td><td>${s.weight||'—'}</td><td>${s.reps||'—'}</td><td>${s.rest||'—'}</td><td style="color:var(--text2)">${s.note||''}</td></tr>`).join('')}</tbody>
            </table></div>
          </div>`).join('')}`:''}
        ${l.pilatesEx?.length?`<div class="section-label">皮拉提斯</div>
          ${l.pilatesEx.map(e=>`<div style="padding:8px 0;border-bottom:1px solid var(--border)">
            <div style="font-weight:600;font-size:13px;margin-bottom:4px;display:flex;align-items:center;gap:6px;flex-wrap:wrap">
              <i class="ti ti-stretching" style="color:var(--teal)"></i>${e.name}
              <span class="badge badge-teal" style="font-size:10px">${e.block||''}</span>
              <span class="badge badge-gray" style="font-size:10px">${e.level||''}</span>
            </div>
            <div style="font-size:12px;color:var(--text2)">
              ${e.springs?.length?`彈簧：${springStr(e.springs)}${e.customSpring?' + '+e.customSpring:''}　`:''}已學 ${e.timesLearned||0} 次
              ${e.note?`<div style="margin-top:2px">${e.note}</div>`:''}
            </div>
          </div>`).join('')}`:''}
        ${l.photos?.length?`<div class="section-label">照片</div>
          <div class="photo-grid" style="margin-bottom:8px">
            ${l.photos.map((p,pi)=>`<div>
              <div class="photo-thumb" onclick="previewPhoto(${pi},'hist',${l.id})"><img src="${p.dataUrl}" alt=""></div>
              ${p.caption?`<div style="font-size:11px;color:var(--text2);margin-top:3px;text-align:center">${p.caption}</div>`:''}
            </div>`).join('')}
          </div>`:''}
        ${l.note?`<div style="margin-top:8px;padding:10px 12px;background:var(--surface2);border-radius:var(--radius-sm);font-size:13px;color:var(--text2);border-left:3px solid #A8C6A1">${l.note}</div>`:''}
      </div>
      <div id="hlog-edit-${l.id}" class="hidden" style="padding:13px;border-top:1px solid var(--border)"></div>
    </div>`;
  }).join('');
}

function editHistLog(logId){
  const l=state.logs.find(x=>x.id===logId);
  const el=document.getElementById('hlog-edit-'+logId);
  if(!el.classList.contains('hidden')){el.classList.add('hidden');return}
  el.classList.remove('hidden');
  el.innerHTML=`<div style="font-size:13px;font-weight:600;margin-bottom:12px">編輯課程資訊</div>
    <div class="f2">
      <div class="field"><label>日期</label><input id="el-date-${logId}" value="${l.date}"></div>
      <div class="field"><label>時間</label><input id="el-time-${logId}" value="${l.time}"></div>
    </div>
    <div class="field"><label>地點</label><input id="el-loc-${logId}" value="${l.location||''}"></div>
    <div class="field"><label>今日備註</label><textarea id="el-note-${logId}">${l.note||''}</textarea></div>
    <div style="display:flex;gap:8px;margin-top:10px">
      <button class="btn btn-primary btn-block" onclick="saveHistLogEdit(${logId})"><i class="ti ti-check"></i> 儲存修改</button>
      <button class="btn" onclick="document.getElementById('hlog-edit-${logId}').classList.add('hidden')"><i class="ti ti-x"></i></button>
    </div>`;
}
function saveHistLogEdit(logId){
  const l=state.logs.find(x=>x.id===logId);
  l.date=document.getElementById('el-date-'+logId).value;
  l.time=document.getElementById('el-time-'+logId).value;
  l.location=document.getElementById('el-loc-'+logId).value;
  l.note=document.getElementById('el-note-'+logId).value;
  save();toast('紀錄已更新！');
  document.getElementById('hlog-edit-'+logId).classList.add('hidden');
  renderHistory();
}

function deleteLog(logId){
  if(!confirm('確定要刪除這筆課程紀錄嗎？\n此操作無法復原。')) return;
  state.logs = state.logs.filter(l => l.id !== logId);
  save();
  toast('課程紀錄已刪除');
  renderHistory();
}

/* ===== TOAST ===== */
function toast(msg,type='success'){
  const el=document.getElementById('toast');
  el.textContent=msg;el.className='toast '+type+' show';
  clearTimeout(el._t);el._t=setTimeout(()=>el.classList.remove('show'),2400);
}

/* ===== SERVICE WORKER ===== */
if('serviceWorker' in navigator){
  try {
    var swB=new Blob(["self.addEventListener('fetch',e=>{e.respondWith(fetch(e.request).catch(()=>new Response('')))});"],{type:'text/javascript'});
    navigator.serviceWorker.register(URL.createObjectURL(swB));
  } catch(e) {}
}

renderStudents();
</script>
</body>
