<body>
<div id="app">
  <div class="header">
    <div>
      <div class="header-title" id="header-title">Coach Studio</div>
      <div class="header-sub" id="header-sub">教練管理系統</div>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
      <button class="header-btn hidden" id="header-action-btn" onclick="headerAction()">
        <i class="ti ti-plus" id="header-action-icon"></i>
      </button>
      <button class="header-btn" id="update-app-btn" onclick="manualUpdate()" title="檢查APP更新" style="position:relative">
        <i class="ti ti-refresh" id="update-icon"></i>
        <span id="update-badge" style="display:none;position:absolute;top:4px;right:4px;width:8px;height:8px;background:#F5EAC2;border-radius:50%;border:1.5px solid #4A6347"></span>
      </button>
    </div>
  </div>

  <div class="content" id="main-content">

    <!-- STUDENTS PAGE -->
    <div id="page-students" class="page active">
      <div id="stu-list-view">
        <div id="students-list"></div>
      </div>
      <div id="stu-detail-view" class="hidden"></div>
      <div id="stu-form-view" class="hidden"></div>
    </div>

    <!-- LOG PAGE -->
    <div id="page-log" class="page">
      <div class="card">
        <div class="card-title" style="margin-bottom:12px"><i class="ti ti-calendar-event" style="color:var(--purple)"></i> 課程基本資訊</div>
        <div class="f2">
          <div class="field"><label>學員</label><select id="log-student"></select></div>
          <div class="field"><label>日期</label><input id="log-date" type="date"></div>
        </div>
        <div class="f2">
          <div class="field"><label>時間</label><input id="log-time" type="time" value="09:00"></div>
          <div class="field"><label>地點</label><input id="log-location" placeholder="健身房"></div>
        </div>
      </div>

      <div class="seg">
        <button class="seg-btn active" onclick="switchSeg('weight')" id="seg-weight">重訓</button>
